{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edge.example/schemas/edge.health.state.v2.schema.json",
  "title": "edge.health.state v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "generated_at",
    "boot",
    "device",
    "resources",
    "services",
    "time_sync",
    "update",
    "summary"
  ],
  "properties": {
    "schema": { "const": "edge.health.state" },
    "schema_version": { "const": "2.0" },

    "generated_at": { "$ref": "#/$defs/rfc3339_utc" },

    "boot": { "$ref": "#/$defs/boot" },
    "device": { "$ref": "#/$defs/device" },

    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_window_sec", "cpu", "memory", "storage", "thermal", "network"],
      "properties": {
        "sample_window_sec": { "type": "integer", "minimum": 1 },

        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["load1", "load5", "load15"],
          "properties": {
            "load1": { "type": "number", "minimum": 0 },
            "load5": { "type": "number", "minimum": 0 },
            "load15": { "type": "number", "minimum": 0 }
          }
        },

        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mem_total_mb", "mem_used_mb", "swap_used_mb"],
          "properties": {
            "mem_total_mb": { "type": "integer", "minimum": 0 },
            "mem_used_mb": { "type": "integer", "minimum": 0 },
            "swap_used_mb": { "type": "integer", "minimum": 0 }
          }
        },

        "storage": {
          "type": "array",
          "items": { "$ref": "#/$defs/storage_mount" }
        },

        "thermal": {
          "type": "array",
          "items": { "$ref": "#/$defs/thermal_sensor" }
        },

        "network": {
          "type": "array",
          "items": { "$ref": "edge.health.network.base.schema.json" }
        },

        "network_routes": {
          "description": "Optional: RTNL route dump / derived route health. Safe to omit until implemented.",
          "anyOf": [
            { "type": "null" },
            { "$ref": "edge.health.network.route.schema.json" }
          ],
          "default": null
        },

        "netfilter": {
          "description": "Optional: netfilter counters/summary. Safe to omit until implemented.",
          "anyOf": [
            { "type": "null" },
            { "$ref": "edge.health.netfilter.schema.json" }
          ],
          "default": null
        }
      }
    },

    "services": { "$ref": "#/$defs/services" },
    "time_sync": { "$ref": "#/$defs/time_sync" },
    "update": { "$ref": "#/$defs/update" },
    "summary": { "$ref": "#/$defs/summary" }
  },

  "$defs": {
    "rfc3339_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },

    "boot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boot_fail_count", "boot_id", "boot_ok", "last_boot_at", "uptime"],
      "properties": {
        "boot_fail_count": { "type": "integer", "minimum": 0 },
        "boot_id": { "type": "string", "minLength": 1 },
        "boot_ok": { "type": "boolean" },
        "last_boot_at": { "$ref": "#/$defs/rfc3339_utc" },
        "uptime": { "type": "integer", "minimum": 0 }
      }
    },

    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch", "device_id", "hostname", "os", "platform"],
      "properties": {
        "arch": { "type": "string", "minLength": 1 },
        "device_id": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string", "minLength": 1 },
        "platform": { "type": "string" },
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": ["distro", "version", "kernel", "build_id"],
          "properties": {
            "distro": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "kernel": { "type": "string", "minLength": 1 },
            "build_id": { "type": "string" }
          }
        }
      }
    },

    "storage_mount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mount", "fs", "used_pct", "avail_mb"],
      "properties": {
        "mount": { "type": "string", "minLength": 1 },
        "fs": {
          "description": "Filesystem type. Use null when unknown; avoid empty string.",
          "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "used_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "avail_mb": { "type": "integer", "minimum": 0 }
      }
    },

    "thermal_sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensor", "temp_c"],
      "properties": {
        "sensor": { "type": "string", "minLength": 1 },
        "temp_c": { "type": "number" }
      }
    },

    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "units"],
      "properties": {
        "overall": { "enum": ["ok", "warn", "crit", "unknown"] },
        "units": {
          "type": "array",
          "items": { "$ref": "#/$defs/service_unit" }
        }
      }
    },

    "service_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "state", "severity", "restart_count"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["ok", "warn", "crit", "unknown"] },
        "restart_count": { "type": "integer", "minimum": 0 },
        "result": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
        "detail": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
        "log_excerpt": {
          "anyOf": [
            { "type": "null" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      }
    },

    "time_sync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "source", "ntp", "ptp"],
      "properties": {
        "overall": { "enum": ["ok", "warn", "crit", "unknown"] },
        "source": { "enum": ["ntp", "ptp", "none"] },

        "ntp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "state": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
            "last_sync_at": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/rfc3339_utc" }] }
          }
        },

        "ptp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },

            "interface": { "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
            "offset_ns": { "anyOf": [{ "type": "null" }, { "type": "integer" }] },
            "rms_ns": { "anyOf": [{ "type": "null" }, { "type": "integer" }] },
            "state": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
            "last_sync_at": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/rfc3339_utc" }] },
            "role": { "anyOf": [{ "type": "null" }, { "type": "string" }] }
          }
        }
      }
    },

    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall"],
      "properties": {
        "overall": { "enum": ["ok", "warn", "crit", "unknown"] }
      }
    },

    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "reasons"],
      "properties": {
        "severity": { "enum": ["ok", "warn", "crit", "unknown"] },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}

