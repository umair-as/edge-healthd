{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.edge.example/edge.health.state.v1.0.json",
  "title": "Edge Device Health Snapshot",
  "description": "Autonomous health state of an edge IoT gateway (RPi5 / VisionFive2 / i.MX93)",
  "type": "object",

  "properties": {
    "schema": { "const": "edge.health.state" },
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },

    "device": {
      "type": "object",
      "properties": {
        "device_id": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string" },
        "platform": { "type": "string" },
        "arch": { "type": "string" },
        "os": {
          "type": "object",
          "properties": {
            "distro": { "type": "string" },
            "version": { "type": "string" },
            "build_id": { "type": "string" },
            "kernel": { "type": "string" }
          },
          "required": ["distro", "kernel"]
        }
      },
      "required": ["device_id", "hostname", "platform", "arch", "os"]
    },

    "boot": {
      "type": "object",
      "properties": {
        "boot_id": { "type": "string" },
        "last_boot_at": { "type": "string", "format": "date-time" },
        "uptime": { "type": "integer", "minimum": 0 },
        "boot_ok": { "type": "boolean" },
        "boot_fail_count": { "type": "integer", "minimum": 0 },
        "last_reboot_reason": { "type": ["string", "null"] }
      },
      "required": [
        "boot_id",
        "last_boot_at",
        "uptime",
        "boot_ok",
        "boot_fail_count"
      ]
    },

    "services": {
      "type": "object",
      "properties": {
        "overall": { "$ref": "#/$defs/severity" },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "state": { "$ref": "#/$defs/service_state" },
              "severity": { "$ref": "#/$defs/severity" },
              "since": {
                "anyOf": [
                  { "type": "string", "format": "date-time" },
                  { "type": "null" }
                ]
              },
              "restart_count": { "type": "integer", "minimum": 0 },
              "result": { "type": ["string", "null"] },
              "detail": { "type": ["string", "null"] },
              "log_excerpt": {
                "type": "array",
                "items": { "type": "string", "maxLength": 512 },
                "maxItems": 20
              }
            },
            "required": ["name", "state", "severity", "restart_count"]
          }
        }
      },
      "required": ["overall", "units"]
    },

    "resources": {
      "type": "object",
      "properties": {
        "sample_window_sec": { "type": "integer", "minimum": 1 },

        "cpu": {
          "type": "object",
          "properties": {
            "load1": { "type": "number", "minimum": 0 },
            "load5": { "type": "number", "minimum": 0 },
            "load15": { "type": "number", "minimum": 0 }
          },
          "required": ["load1", "load5", "load15"]
        },

        "memory": {
          "type": "object",
          "properties": {
            "mem_total_mb": { "type": "integer", "minimum": 0 },
            "mem_used_mb": { "type": "integer", "minimum": 0 },
            "swap_used_mb": { "type": "integer", "minimum": 0 }
          },
          "required": ["mem_total_mb", "mem_used_mb", "swap_used_mb"]
        },

        "storage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mount": { "type": "string" },
              "fs": { "type": "string" },
              "used_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
              "avail_mb": { "type": "integer", "minimum": 0 }
            },
            "required": ["mount", "used_pct", "avail_mb"]
          }
        },

        "thermal": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sensor": { "type": "string" },
              "temp_c": { "type": "number" }
            },
            "required": ["sensor", "temp_c"]
          }
        },

        "network": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ifname": { "type": "string" },
              "link": { "$ref": "#/$defs/link_state" },

              "rx_bytes": { "type": "integer", "minimum": 0 },
              "tx_bytes": { "type": "integer", "minimum": 0 },
              "rx_packets": { "type": "integer", "minimum": 0 },
              "tx_packets": { "type": "integer", "minimum": 0 },
              "rx_dropped": { "type": "integer", "minimum": 0 },
              "tx_dropped": { "type": "integer", "minimum": 0 },
              "rx_err": { "type": "integer", "minimum": 0 },
              "tx_err": { "type": "integer", "minimum": 0 },

              "ip": { "type": ["string", "null"] },
              "carrier": { "type": ["boolean", "null"] },
              "speed_mbps": {
                "anyOf": [
                  { "type": "integer", "minimum": 0 },
                  { "type": "null" }
                ]
              },
              "duplex": {
                "anyOf": [
                  { "type": "string", "enum": ["full", "half", "unknown"] },
                  { "type": "null" }
                ]
              }
            },
            "required": [
              "ifname",
              "link",
              "rx_bytes",
              "tx_bytes",
              "rx_packets",
              "tx_packets",
              "rx_dropped",
              "tx_dropped",
              "rx_err",
              "tx_err"
            ]
          }
        }
      },
      "required": ["sample_window_sec", "cpu", "memory", "network"]
    },

    "time_sync": {
      "type": "object",
      "properties": {
        "overall": { "$ref": "#/$defs/severity" },
        "source": { "$ref": "#/$defs/time_sync_source" },

        "ntp": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "state": { "$ref": "#/$defs/time_sync_state" },
            "last_sync_at": {
              "anyOf": [
                { "type": "string", "format": "date-time" },
                { "type": "null" }
              ]
            }
          },
          "required": ["enabled"]
        },

        "ptp": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interface": { "type": ["string", "null"] },
            "offset_ns": { "type": ["integer", "null"] },
            "rms_ns": { "type": ["integer", "null"], "minimum": 0 },
            "state": { "$ref": "#/$defs/time_sync_state" },
            "last_sync_at": {
              "anyOf": [
                { "type": "string", "format": "date-time" },
                { "type": "null" }
              ]
            },
            "role": { "type": ["string", "null"] }
          },
          "required": ["enabled"]
        }
      },
      "required": ["overall", "source"]
    },

    "update": {
      "type": "object",
      "properties": {
        "overall": { "$ref": "#/$defs/severity" },
        "active_slot": { "type": ["string", "null"] },
        "last_update": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "installed_at": {
                  "anyOf": [
                    { "type": "string", "format": "date-time" },
                    { "type": "null" }
                  ]
                },
                "result": { "$ref": "#/$defs/update_result" },
                "detail": { "type": ["string", "null"] }
              },
              "required": ["id", "result"]
            },
            { "type": "null" }
          ]
        }
      },
      "required": ["overall"]
    },

    "summary": {
      "type": "object",
      "properties": {
        "severity": { "$ref": "#/$defs/severity" },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(:[a-zA-Z0-9_.:/-]+)?$"
          }
        },
        "notes": { "type": ["string", "null"] }
      },
      "required": ["severity", "reasons"]
    }
  },

  "required": [
    "schema",
    "schema_version",
    "generated_at",
    "device",
    "boot",
    "services",
    "resources",
    "time_sync",
    "update",
    "summary"
  ],

  "$defs": {
    "severity": { "enum": ["ok", "warn", "crit", "unknown"] },
    "service_state": {
      "enum": [
        "active",
        "inactive",
        "failed",
        "activating",
        "deactivating",
        "unknown"
      ]
    },
    "link_state": { "enum": ["up", "down", "unknown"] },
    "time_sync_source": { "enum": ["none", "ntp", "ptp"] },
    "time_sync_state": {
      "enum": ["locked", "free_running", "holdover", "unknown"]
    },
    "update_result": { "enum": ["success", "failed", "unknown"] }
  }
}
