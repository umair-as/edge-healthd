{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edge.example/schemas/edge.health.network.ethtool.schema.json",
  "title": "edge.health.network.ethtool v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "speed_mbps": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
    "duplex": { "anyOf": [{ "type": "null" }, { "enum": ["unknown", "half", "full"] }] },

    "autoneg": { "anyOf": [{ "type": "null" }, { "type": "boolean" }] },
    "port": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
    "link_detected": { "anyOf": [{ "type": "null" }, { "type": "boolean" }] },

    "driver": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
    "bus_info": { "anyOf": [{ "type": "null" }, { "type": "string" }] }
  }
}

