{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edge.example/schemas/edge.health.network.route.schema.json",
  "title": "edge.health.network.route v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["routes_v4", "routes_v6"],
  "properties": {
    "routes_v4": {
      "type": "array",
      "items": { "$ref": "#/$defs/route" }
    },
    "routes_v6": {
      "type": "array",
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dst", "oif"],
      "properties": {
        "dst": {
          "description": "CIDR like 0.0.0.0/0 or 192.168.0.0/24 or ::/0",
          "type": "string",
          "minLength": 1
        },
        "gateway": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
        "oif": { "type": "string", "minLength": 1 },
        "prefsrc": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
        "metric": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
        "proto": { "anyOf": [{ "type": "null" }, { "type": "string" }] }
      }
    }
  }
}

