{
  "device_id": "edge-001",
  "platform": "visionfive2",
  "snapshot_file": "/run/health/state.json",
  "state_dir": "/data/edge/health",
  "collect_interval_sec": 60,
  "log_level": "info",
  "dbus_timeout_ms": 2000,
  "sample_window_sec": 60,

  "monitored_services": [
    "sshd.socket",
    "NetworkManager.service"
  ],

  "monitored_mounts": [
    "/",
    "/data"
  ],

  "monitored_interfaces": [
    "eth0",
    "eth1"
  ],

  "enable_ntp": true,
  "enable_thermal": true,
  "enable_update_tracking": true,

  "thresholds": {
    "cpu_load_warn": 80,
    "cpu_load_crit": 95,
    "mem_used_warn": 80,
    "mem_used_crit": 95,
    "disk_used_warn": 80,
    "disk_used_crit": 95,
    "temp_warn_c": 70.0,
    "temp_crit_c": 85.0,
    "service_restart_warn": 3,
    "service_restart_crit": 10,
    "boot_fail_warn": 1,
    "boot_fail_crit": 3
  }
  ,
  "log_excerpt": {
    "max_lines": 20,
    "min_priority": "info",
    "window_sec": 0
  }
}
