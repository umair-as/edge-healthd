[Unit]
Description=Edge Device Health Monitoring Daemon
Documentation=https://github.com/umair-uas/edge-healthd
After=network.target local-fs.target
Wants=network.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=notify
ExecStart=/usr/bin/edge-healthd
Restart=on-failure
RestartSec=10
WatchdogSec=150
TimeoutStopSec=15

# Journal routing
StandardOutput=journal
StandardError=journal
SyslogIdentifier=edge-healthd

# User/group
User=edgehealth
Group=edgehealth

# Capabilities (needed for NETLINK_ROUTE socket)
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
NoNewPrivileges=yes

# Filesystem protection
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadOnlyPaths=/proc /sys /etc
RuntimeDirectory=health
RuntimeDirectoryMode=0750
ReadWritePaths=/data/edge/health

# Kernel protection
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
# Keep full /proc view for non-process metrics (e.g. /proc/meminfo).
# Process visibility is still restricted by ProtectProc=invisible.
ProcSubset=all

# Privilege restrictions
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
MemoryDenyWriteExecute=yes
LockPersonality=yes
RemoveIPC=yes
UMask=0027

# System call filtering
SystemCallFilter=@system-service @network-io @timer
SystemCallFilter=~@privileged @resources @mount @swap @reboot @raw-io @obsolete @cpu-emulation @debug @keyring @module @clock
SystemCallErrorNumber=EPERM

# Resource limits
MemoryMax=64M
CPUQuota=10%

[Install]
WantedBy=multi-user.target
