[Unit]
Description=Edge Device Health Monitoring Daemon
Documentation=https://github.com/umair-as/edge-healthd
After=network.target local-fs.target
Wants=network.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=notify
ExecStart=/usr/bin/edge-healthd
Restart=on-failure
RestartSec=10
WatchdogSec=150
TimeoutStopSec=15

# Journal routing
StandardOutput=journal
StandardError=journal
SyslogIdentifier=edge-healthd

# User/group
User=edgehealth
Group=edgehealth
# JournalProbe reads the system-wide journal (priority <= err). Without this the
# unprivileged daemon only sees its own messages, so journal.error_count is
# always 0 (the probe is blind, not the system clean). systemd skips this line
# with a warning if the group is absent.
SupplementaryGroups=systemd-journal

# Capabilities: none required. rtnetlink monitoring (RTMGRP_LINK/IPV4_IFADDR)
# and the ethtool generic-netlink query are unprivileged reads — CAP_NET_RAW
# governs AF_PACKET/SOCK_RAW, which the daemon never uses. Drop the whole
# bounding set so the process can hold no capability.
CapabilityBoundingSet=
NoNewPrivileges=yes

# Filesystem protection
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadOnlyPaths=/proc /sys /etc
RuntimeDirectory=health
RuntimeDirectoryMode=0750
ReadWritePaths=/data/edge/health

# Kernel protection
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
# Keep full /proc view for non-process metrics (e.g. /proc/meminfo).
# Process visibility is still restricted by ProtectProc=invisible.
ProcSubset=all

# Privilege restrictions
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
MemoryDenyWriteExecute=yes
LockPersonality=yes
RemoveIPC=yes
UMask=0027

# System call filtering
SystemCallFilter=@system-service @network-io @timer
SystemCallFilter=~@privileged @resources @mount @swap @reboot @raw-io @obsolete @cpu-emulation @debug @keyring @module @clock
SystemCallErrorNumber=EPERM
# Block syscalls issued through a non-native ABI (e.g. i386 on x86-64), a common
# seccomp-bypass avenue.
SystemCallArchitectures=native

# Resource limits
MemoryMax=64M
CPUQuota=10%

[Install]
WantedBy=multi-user.target
